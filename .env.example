# sqlmux 配置样例:复制为 .env(不入库)或经 hub 密钥库注入
# Archery 地址(mysql-archery-query 同款缺省)
AGENT_ARCHERY_URL=https://archery.yunlu-tech.cn
# 可选:env cookie 覆盖(缺省走 Chrome 登录态 → hub 密钥库账密)
AGENT_ARCHERY_CSRFTOKEN=
AGENT_ARCHERY_SESSIONID=
# 可选:网关 mysql_native_password 校验密码;留空=接受任意用户(仅 loopback,建议留空+靠 loopback 边界)
SQLMUX_PASSWORD=
# 可选:端口整体偏移(默认 13306 起)
SQLMUX_BASE_PORT=13306
